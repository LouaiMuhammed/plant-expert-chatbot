APP_NAME="Thamara"
APP_VERSION="0.1"

FILE_ALLOWED_TYPE=[".txt", ".pdf"]
FILE_MAX_SIZE=10

FILE_DEFAULT_CHUNK_SIZE=512000

MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin
MONGODB_URL="mongodb://admin:admin@localhost:27018/?authSource=admin"
MONGODB_DATABASE="thamara-app"

# ==== LLM Config ====

GENERATION_BACKEND = "COHERE"
EMBEDDING_BACKEND = "COHERE"

OPENAI_API_KEY=""
OPENAI_API_URL=""
COHERE_API_KEY=""

GENERATION_MODEL_ID="command-a-03-2025"
EMBEDDING_MODEL_ID="embed-multilingual-light-v3.0"
EMBEDDING_MODEL_SIZE=384


INPUT_DEFAULT_MAX_CHARACTERS=
GENERATION_DEFAULT_MAX_TOKENS=
GENERATION_DEFAULT_TEMPERATURE=


# ==== VectorDB Config ====

VECTOR_DB_BACKEND = "QDRANT"
VECTOR_DB_PATH = "qdrant_db"
VECTOR_DB_DISTANCE_METHOD = "cosine"



# ==== Template Config ====
PRIMARY_LANG = "en"
DEFAULT_LANG = "en"
